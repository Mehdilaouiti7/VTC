# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (emails)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Reservations <reservations@votredomaine.com>"
NOTIFY_ADMIN_EMAIL=mehdilaouiti7@gmail.com

# WhatsApp Business Platform (Meta Cloud API) — notifications automatiques au
# client. Sans ces deux valeurs, les envois WhatsApp sont simplement ignorés
# (le site continue de fonctionner normalement). Voir lib/whatsapp.ts pour le
# détail des 5 templates à créer et faire approuver dans Meta Business Manager
# avant que l'envoi fonctionne réellement.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Bot de réservation WhatsApp (app/api/whatsapp/webhook). WHATSAPP_VERIFY_TOKEN
# est une chaîne de votre choix (ex: un mot de passe généré) — la même valeur
# doit être saisie dans la configuration du webhook sur Meta for Developers.
# Sans elle, le webhook refuse la vérification et ne reçoit aucun message.
WHATSAPP_VERIFY_TOKEN=

# Coordonnées publiques affichées sur le site
NEXT_PUBLIC_PHONE_NUMBER="+33 6 00 00 00 00"
NEXT_PUBLIC_WHATSAPP_NUMBER="33600000000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@votredomaine.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
