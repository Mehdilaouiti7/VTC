# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (emails)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Reservations <reservations@votredomaine.com>"
NOTIFY_ADMIN_EMAIL=mehdilaouiti7@gmail.com

# WhatsApp (WaSenderAPI — wasenderapi.com) — notifications automatiques au
# client ET au chauffeur à chaque nouvelle demande. Texte libre, pas de
# template à faire approuver. Récupérez le token depuis le tableau de bord
# WaSenderAPI (compte déjà abonné). Sans cette valeur, les envois WhatsApp
# sont simplement ignorés (le site continue de fonctionner normalement).
WASENDER_API_TOKEN=

# Numéro WhatsApp du chauffeur (celui qui reçoit le récapitulatif de chaque
# nouvelle demande, en plus de l'email). Format international sans espaces,
# ex: 33600000000.
NOTIFY_ADMIN_WHATSAPP=

# WHATSAPP_VERIFY_TOKEN ne concerne que le bot conversationnel
# app/api/whatsapp/webhook (API officielle Meta, actuellement en pause —
# non requis pour les notifications ci-dessus qui passent par WaSenderAPI).
WHATSAPP_VERIFY_TOKEN=

# Coordonnées publiques affichées sur le site
NEXT_PUBLIC_PHONE_NUMBER="+33 6 00 00 00 00"
NEXT_PUBLIC_WHATSAPP_NUMBER="33600000000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@votredomaine.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
